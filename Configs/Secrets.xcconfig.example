// Secrets.xcconfig
// DO NOT COMMIT THIS FILE - it contains API keys
//
// Copy this file to Secrets.xcconfig and add your API keys
// The actual Secrets.xcconfig is gitignored

// Namestone API key for ENS subdomain management
// Get your key at: https://namestone.com/try-namestone
NAMESTONE_API_KEY = YOUR_API_KEY_HERE

// Optional: private XMTP remote attachment upload endpoint (HTTPS)
// Recommended: your own Cloudflare Worker / R2 upload endpoint with CORS enabled for web clients
// Example: xmtp-upload.example.workers.dev/upload
// IMPORTANT: Prefer no scheme in xcconfig values (// starts comments in xcconfig)
// The app auto-prefixes https:// when needed.
XMTP_UPLOAD_ENDPOINT =

// Optional: bearer token required by your upload endpoint
XMTP_UPLOAD_BEARER_TOKEN = 

// Optional: Pimlico API key for ERC-4337 bundler (post-quantum account deployment)
// Get your key at: https://dashboard.pimlico.io
PIMLICO_API_KEY = 
